{
  "manifest_version": 3,
  "name": "Knowledge Map Extension",
  "version": "1.1.0",
  "description": "Build visual knowledge maps from AI conversations on ChatGPT, Claude, Gemini, and Grok",

  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs"
  ],

  "background": {
    "service_worker": "src/core/background.js",
    "type": "module"    
  },

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "action": {
    "default_title": "Open Knowledge Map",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/styles/inject.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
  {
    "resources": [
      "src/adapters/*.js",
      "src/core/*.js",
      "src/utils/*.js",
      "src/assets/*.js",
      "src/sidepanel/*.js",
      "src/sidepanel/*.css",
      "src/styles/*.css"
    ],
    "matches": [
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://x.com/*"
    ]
  }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/*"
  ],

  "minimum_chrome_version": "116"
}
